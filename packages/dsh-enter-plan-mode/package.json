{
  "name": "dsh-enter-plan-mode",
  "version": "0.1.0",
  "description": "DSH 进入计划模式工具：给模型一个可调用的 dsh_enter_plan_mode_enter_plan_mode，把当前会话切进计划模式（探索并提交可评审的方案），与内置的 exit_plan_mode 配对。",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml",
    "README.md",
    "README.en.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "verify": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/enter-plan-mode.test.mjs",
    "prepare": "npm run build"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "plan-mode",
    "planning",
    "deepseek"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/feng-yifan/dsh-plugins",
    "directory": "packages/dsh-enter-plan-mode"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
