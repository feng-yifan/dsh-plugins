{
  "name": "dsh-alertmanager",
  "version": "0.1.0",
  "description": "DSH AlertManager 告警面板：读取 AlertManager v2 实时告警，多选后在指定工作区新建会话，让 agent 立即开始处理。",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "locale",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "README.en.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.client.json && node scripts/build-client.mjs",
    "verify": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "pretest": "npm run build",
    "test": "node --test test/",
    "prepare": "npm run build"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "~18.3.12",
    "react": "^18.2.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/feng-yifan/dsh-plugins",
    "directory": "packages/dsh-alertmanager"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "alertmanager",
    "prometheus",
    "alerts",
    "deepseek"
  ]
}
