{
  "name": "dsh-at-enhancement",
  "version": "0.1.0",
  "description": "DSH 外部 @ 文件引用增强：让输入框里的 @ 补全可以逐级浏览并引用工作区外的任意绝对路径文件/目录，选中后插入绝对路径，由 read 工具按路径读取。",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "locale",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "test"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.client.json && node scripts/build-client.mjs",
    "verify": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "prepare": "npm run build",
    "pretest": "npm run build",
    "test": "node --test test/external-file-references.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ],
      "immediately": true
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "file-reference",
    "at-completion",
    "deepseek"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/feng-yifan/dsh-plugins",
    "directory": "packages/dsh-at-enhancement"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "~18.3.12",
    "react": "^18.2.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
